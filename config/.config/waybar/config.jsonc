{
    "layer": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "hyprland/submap", "group/volume", "battery", "bluetooth", "network", "cpu", "memory"],
    "hyprland/window": {
        "max-length": 50
    },
    "battery": {
        "interval": 60,
        "format": "{capacity}% {icon}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
    },
    "bluetooth": {
      "format": "",
      "format-disabled": "󰂲",
      "format-connected": " {num_connections}",
      "tooltip-format": "Bluetooth\nStatus: {status}",
      "tooltip-format-connected": "Bluetooth\nStatus: Connected\nDevices: {num_connections}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "  {device_alias}\n  {device_address}",
      "on-click": "blueman-manager"
    },
    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        "max-length": 10
    },
    "memory": {
        "interval": 10,
        "format": " {used}G",
        "tooltip-format": "{used:0.1f}G/{total:0.1f}G used"
    },
    "network": {
        "format": "",
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "󰤭", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "󰖪",
        "max-length": 50,
        "on-click": "nm-connection-editor"
    },

    "clock": {
       	"format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "format": {
                "today": "<span color='#ffffff'><b>{}</b></span>"
            }
        },
	"on-click": "swaync-client -t"
    },


    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", ""]
        },
        "scroll-step": 1,
        "ignored-sinks": ["Easy Effects Sink"],
        "on-click": "pavucontrol"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "group/volume": {
      "orientation": "horizontal",
      "modules": [
        "pulseaudio",
        "pulseaudio/slider"
      ]
    },
    "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
    }
}
