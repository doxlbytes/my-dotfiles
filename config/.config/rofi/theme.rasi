/* =========================================================
   Monochrome Rofi
   Base: #181818
   Primary: #E4E4E4
   Secondary: #A8A8A8
   Muted: #707070
   Square / No Accent
   ========================================================= */

* {
    bg0: #181818;
    bg1: #1F1F1F;
    bg2: #303030;
    bg3: #282828;

    fg0: #E4E4E4;
    fg1: #E4E4E4;
    fg2: #A8A8A8;
    fg3: #707070;
}

@import "base"
