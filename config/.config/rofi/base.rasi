* {
    font: "JetBrainsMono Nerd Font 11";

    background-color: transparent;
    text-color: @fg1;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

/* ---------- Window ---------- */

window {
    location: south;
    y-offset: 0px;
    width: 480;

    border: 1px;
    border-radius: 0px;
    border-color: @bg2;

    background-color: @bg0;
}

/* ---------- Main ---------- */

mainbox {
    padding: 12px;
}

/* ---------- Search ---------- */

inputbar {
    background-color: @bg1;
    border-color: @bg2;

    border: 2px;
    border-radius: 0px;

    padding: 8px 16px;
    spacing: 8px;

    children: [ prompt, entry ];
}

prompt {
    text-color: @fg2;
}

entry {
    placeholder: "Search";
    placeholder-color: @fg3;
}

/* ---------- Message ---------- */

message {
    margin: 12px 0px 0px;

    border: 1px;
    border-radius: 0px;
    border-color: @bg2;

    background-color: @bg2;
}

textbox {
    padding: 8px 24px;
}

/* ---------- List ---------- */

listview {
    background-color: transparent;

    margin: 12px 0px 0px;
    lines: 8;
    columns: 1;

    fixed-height: false;
}

/* ---------- Elements ---------- */

element {
    padding: 8px 16px;
    spacing: 8px;

    border-radius: 0px;
}

element normal active {
    text-color: @fg2;
}

element alternate active {
    text-color: @fg2;
}

element selected normal,
element selected active {
    background-color: @bg3;
    text-color: @fg1;
}

/* ---------- Icons ---------- */

element-icon {
    size: 1.2em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}

/* ---------- Tooltip ---------- */

tooltip {
    background-color: @bg1;
    text-color: @fg1;

    border: 1px;
    border-color: @bg2;
    border-radius: 0px;
}
