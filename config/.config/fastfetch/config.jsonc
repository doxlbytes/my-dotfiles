{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "source": "arch",
    "padding": {
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "white",
      "2": "white",
      "3": "white",
      "4": "white",
      "5": "white",
      "6": "white"
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [
    {
      "type": "title",
      "format": "\u001b[38;2;128;128;128m{user-name}@{host-name}\u001b[0m"
    },


    {
      "type": "chassis",
      "key": "Chassis",
      "keyWidth": 10,
      "format": "{1} {2} {3}",
      "keyColor": "#808080"
    },
    {
      "type": "os",
      "key": "OS",
      "keyWidth": 10,
      "format": "{name}",
      "keyColor": "#808080"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyWidth": 10,
      "format": "{release}",
      "keyColor": "#808080"
    },

    {
      "type": "wm",
      "key": "WM",
      "keyWidth": 10,
      "format": "{2}",
      "keyColor": "#808080"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyWidth": 10,
      "format": "{1}",
      "keyColor": "#808080"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyWidth": 10,
      "format": "{2}",
      "keyColor": "#808080"
    },

    {
      "type": "cpu",
      "key": "CPU",
      "keyWidth": 10,
      "format": "{1}",
      "keyColor": "#808080"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyWidth": 10,
      "format": "{2}",
      "keyColor": "#808080"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyWidth": 10,
      "keyColor": "#808080"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyWidth": 10,
      "format": "{formatted}",
      "keyColor": "#808080"
    },

    {
      "type": "break"
    }
  ]
}
