/* =========================================================
   Monochrome QSS
   Base: #181818
   Text: #E4E4E4
   ========================================================= */

/* ---------- Global ---------- */

* {
    outline: none;
}

QWidget {
    background: #181818;
    color: #E4E4E4;
    selection-background-color: #303030;
    selection-color: #E4E4E4;
}

/* ---------- Main windows ---------- */

QMainWindow,
QDialog,
QWidget#centralWidget {
    background: #181818;
    color: #E4E4E4;
}

/* ---------- Buttons ---------- */

QPushButton {
    background: #232323;
    color: #E4E4E4;
    border: 1px solid #333333;
    border-radius: 0;
    padding: 5px 12px;
}

QPushButton:hover {
    background: #282828;
    border-color: #3A3A3A;
    color: #E4E4E4;
}

QPushButton:pressed {
    background: #303030;
    border-color: #454545;
}

QPushButton:disabled {
    background: #1F1F1F;
    color: #707070;
    border-color: #303030;
}

/* ---------- Line edits ---------- */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background: #1F1F1F;
    color: #E4E4E4;
    border: 1px solid #333333;
    border-radius: 0;
    padding: 5px 7px;
    selection-background-color: #303030;
    selection-color: #E4E4E4;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: #3A3A3A;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #454545;
    background: #202020;
}

/* ---------- Combo boxes ---------- */

QComboBox {
    background: #232323;
    color: #E4E4E4;
    border: 1px solid #333333;
    border-radius: 0;
    padding: 5px 8px;
}

QComboBox:hover {
    background: #282828;
    border-color: #3A3A3A;
}

QComboBox:focus {
    border-color: #454545;
}

QComboBox QAbstractItemView {
    background: #1F1F1F;
    color: #E4E4E4;
    border: 1px solid #333333;
    selection-background-color: #303030;
    selection-color: #E4E4E4;
}

/* ---------- Spin boxes ---------- */

QSpinBox,
QDoubleSpinBox {
    background: #1F1F1F;
    color: #E4E4E4;
    border: 1px solid #333333;
    border-radius: 0;
    padding: 4px 6px;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #3A3A3A;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #454545;
}

/* ---------- Checkboxes / radio ---------- */

QCheckBox,
QRadioButton {
    color: #E4E4E4;
    spacing: 7px;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #E4E4E4;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

/* ---------- Sliders ---------- */

QSlider::groove:horizontal {
    height: 4px;
    background: #333333;
    border-radius: 0;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -4px 0;
    background: #E4E4E4;
    border: 1px solid #454545;
    border-radius: 0;
}

QSlider::handle:horizontal:hover {
    background: #E4E4E4;
}

/* ---------- Progress bars ---------- */

QProgressBar {
    background: #1F1F1F;
    color: #E4E4E4;
    border: 1px solid #333333;
    border-radius: 0;
    text-align: center;
}

QProgressBar::chunk {
    background: #E4E4E4;
    border-radius: 0;
}

/* ---------- Menus ---------- */

QMenu {
    background: #1F1F1F;
    color: #E4E4E4;
    border: 1px solid #333333;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 0;
    color: #E4E4E4;
}

QMenu::item:selected {
    background: #303030;
    color: #E4E4E4;
}

QMenu::separator {
    height: 1px;
    background: #333333;
    margin: 4px 8px;
}

/* ---------- Context menus ---------- */

QAbstractItemView {
    background: #1F1F1F;
    color: #E4E4E4;
    border: 1px solid #333333;
    selection-background-color: #303030;
    selection-color: #E4E4E4;
}

/* ---------- Tabs ---------- */

QTabWidget::pane {
    background: #181818;
    border: 1px solid #333333;
    border-radius: 0;
}

QTabBar::tab {
    background: #1F1F1F;
    color: #A8A8A8;
    border: 1px solid #333333;
    border-radius: 0;
    padding: 6px 12px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background: #282828;
    color: #E4E4E4;
}

QTabBar::tab:selected {
    background: #303030;
    color: #E4E4E4;
    border-color: #454545;
}

/* ---------- Scrollbars ---------- */

QScrollBar:vertical {
    background: #181818;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #333333;
    min-height: 30px;
    border-radius: 0;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #454545;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background: #181818;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #333333;
    min-width: 30px;
    border-radius: 0;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #454545;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
}

/* ---------- Tooltips ---------- */

QToolTip {
    background: #232323;
    color: #E4E4E4;
    border: 1px solid #3A3A3A;
    border-radius: 0;
    padding: 5px 7px;
}

/* ---------- Group boxes ---------- */

QGroupBox {
    background: #181818;
    color: #E4E4E4;
    border: 1px solid #333333;
    border-radius: 0;
    margin-top: 10px;
    padding: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #E4E4E4;
    background: #181818;
}

/* ---------- Status bar ---------- */

QStatusBar {
    background: #1B1B1B;
    color: #A8A8A8;
    border-top: 1px solid #333333;
}

/* ---------- Tool bars ---------- */

QToolBar {
    background: #1B1B1B;
    border: none;
    spacing: 4px;
}

QToolButton {
    background: transparent;
    color: #E4E4E4;
    border: 1px solid transparent;
    border-radius: 0;
    padding: 5px;
}

QToolButton:hover {
    background: #282828;
    border-color: #333333;
    color: #E4E4E4;
}

QToolButton:pressed,
QToolButton:checked {
    background: #303030;
    border-color: #454545;
}

/* ---------- Dock widgets ---------- */

QDockWidget {
    color: #E4E4E4;
}

QDockWidget::title {
    background: #1B1B1B;
    color: #E4E4E4;
    padding: 5px;
    border-bottom: 1px solid #333333;
}

/* ---------- Frames ---------- */

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    border: 1px solid #333333;
}

/* ---------- Disabled ---------- */

QWidget:disabled {
    color: #707070;
}
